{
  "manifest_version": 2,
  "name": "Video2Player",
  "version": "2.0.0",
  "description": "Detects videos on web pages and opens them in a built-in touch-first player: thick seek bar, gestures, quality, audio and subtitle picker, colour tuning and skip intro. Android and desktop.",
  "author": "kiraitachi",
  "homepage_url": "https://github.com/kiraitachi/Firefox-Video2player",
  "browser_specific_settings": {
    "gecko": {
      "id": "video2player@firefox-android",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_title": "Video2Player",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  }
}
